---
layout: default
---
<div class="post">
  <header class="post-header">
    <h1 class="post-title">
      {% if site.title == 'blank' %}
        {% if page.language == 'zh' or page.permalink == '/zh/' %}
          {% comment %} Chinese name {% endcomment %}
          <span class="font-weight-bold">{{ site.last_name_zh }}</span>{{ site.first_name_zh }}
        {% else %}
          {% comment %} English name {% endcomment %}
          <span class="font-weight-bold">{{ site.first_name }}</span> {{ site.middle_name }}
          {{ site.last_name }}
        {% endif %}
      {% else %}
        {{ site.title }}
      {% endif %}
    </h1>
    <p class="desc">{{ page.subtitle }}</p>
  </header>

  <article>
    {% if page.profile %}
      <div class="profile float-{% if page.profile.align == 'left' %}left{% else %}right{% endif %}">
        {% if page.profile.image %}
          {% assign profile_image_path = page.profile.image | prepend: 'assets/img/' %}
          {% if page.profile.image_circular %}
            {% assign profile_image_class = 'img-fluid z-depth-1 rounded-circle' %}
          {% else %}
            {% assign profile_image_class = 'img-fluid z-depth-1
      rounded' %}
          {% endif %}
          {% capture sizes %}(min-width: {{ site.max_width }}) {{ site.max_width | minus: 30 | times: 0.3}}px, (min-width: 576px)
      30vw, 95vw"{% endcapture %}
          {%
            include figure.liquid loading="eager" path=profile_image_path class=profile_image_class sizes=sizes alt=page.profile.image
            cache_bust=true
          %}
        {% endif %}
        {% if page.profile.more_info %}
          <div class="more-info">{{ page.profile.more_info }}</div>
        {% endif %}
        {% if page.social %}
          <div class="social" style="margin-top: 15px; text-align: center;">
            <div class="contact-icons">{% include social.liquid %}</div>
          </div>
        {% endif %}
      </div>
    {% endif %}

    {% assign full_content = content %}
    {% comment %} Extract sections using HTML comments {% endcomment %}
    {% assign parts = full_content | split: "<!-- TEACHING_ASSISTANT_START -->" %}
    {% if parts.size > 1 %}
      {% assign before_teaching = parts[0] %}
      {% assign temp = parts[1] | split: "<!-- TEACHING_ASSISTANT_END -->" %}
      {% if temp.size > 1 %}
        {% assign teaching_content = temp[0] %}
        {% assign rest = temp[1] | split: "<!-- ACADEMIC_SERVICE_START -->" %}
        {% if rest.size > 1 %}
          {% assign service_temp = rest[1] | split: "<!-- ACADEMIC_SERVICE_END -->" %}
          {% if service_temp.size > 1 %}
            {% assign service_content = service_temp[0] %}
          {% else %}
            {% assign service_content = "" %}
          {% endif %}
        {% else %}
          {% assign service_content = "" %}
        {% endif %}
      {% else %}
        {% assign teaching_content = "" %}
        {% assign service_content = "" %}
      {% endif %}
    {% else %}
      {% assign before_teaching = full_content %}
      {% assign teaching_content = "" %}
      {% assign service_content = "" %}
    {% endif %}
    
    <div class="clearfix">{{ before_teaching }}</div>

    <!-- News -->
    {% if page.announcements and page.announcements.enabled %}
      <h2>
        <a href="{{ '/news/' | relative_url }}" style="color: inherit">News</a>
      </h2>
      {% include news.liquid limit=true %}
    {% endif %}

    <!-- Latest posts -->
    {% if page.latest_posts and page.latest_posts.enabled %}
      <h2>
        <a href="{{ '/blog/' | relative_url }}" style="color: inherit">latest posts</a>
      </h2>
      {% include latest_posts.liquid %}
    {% endif %}

    <!-- Selected papers -->
    {% if page.selected_papers %}
      <h2>
        {% if page.language == 'zh' or page.permalink == '/zh/' %}
          <a href="{{ '/zh/publications/' | relative_url }}" style="color: inherit">学术成果</a>
        {% else %}
          <a href="{{ '/publications/' | relative_url }}" style="color: inherit">Publications</a>
        {% endif %}
      </h2>
      {% include selected_papers.liquid %}
    {% endif %}

    <!-- Research Projects -->
    {% assign research_projects_items = site.research_projects | where_exp: "item", "item.display != false" | where_exp: "item", "item.path != '_research_projects/template.md'" | where_exp: "item", "item.path != '_research_projects/example_project.md'" | sort: "importance" %}
    {% if research_projects_items.size > 0 %}
      <h2>
        {% if page.language == 'zh' or page.permalink == '/zh/' %}
          研究项目
        {% else %}
          Research Projects
        {% endif %}
      </h2>
      <div class="publications">
        <ol class="bibliography">
          {% for project in research_projects_items %}
            <li>
              {% include research_project.liquid %}
            </li>
          {% endfor %}
        </ol>
      </div>
    {% endif %}

    <!-- Teaching Assistant (extracted from content) -->
    {% if teaching_content != "" %}
      <div class="clearfix">{{ teaching_content | markdownify }}</div>
    {% endif %}

    <!-- Academic Service (extracted from content) -->
    {% if service_content != "" %}
      <div class="clearfix">{{ service_content | markdownify }}</div>
    {% endif %}

    {% if site.newsletter and site.newsletter.enabled and site.footer_fixed %}
      {% include newsletter.liquid center=true %}
    {% endif %}
  </article>
  
  <!-- Visitor Statistics -->
  <div style="margin-top: 40px; text-align: center;">
    <script type='text/javascript' id='mapmyvisitors' src='https://mapmyvisitors.com/map.js?cl=fffafa&w=250&t=tt&d=hhp36brVmxCzzD1alcesE3X0A71-jyoD5SRCEM2eGSo&co=989898&ct=ffffff'></script>
  </div>
</div>
