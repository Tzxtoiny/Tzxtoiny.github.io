<header>
  <!-- Nav Bar -->
  <nav id="navbar" class="navbar navbar-light navbar-expand-sm {% if site.navbar_fixed %}fixed-top{% else %}sticky-top{% endif %}" role="navigation">
    <div class="container">
      {% if page.permalink != '/' and page.permalink != '/zh/' %}
        {% if page.language == 'zh' or page.permalink contains '/zh/' %}
          {% assign home_url = '/zh/' %}
        {% else %}
          {% assign home_url = '/' %}
        {% endif %}
        <a class="navbar-brand title font-weight-lighter" href="{{ home_url | relative_url }}">
          {% if site.title == 'blank' %}
            {% if page.language == 'zh' or page.permalink contains '/zh/' %}
              {% comment %} Chinese name {% endcomment %}
              {% if site.last_name_zh %}
                <span class="font-weight-bold">
                  {{- site.last_name_zh -}}
                </span>
              {% endif %}
              {% if site.first_name_zh %}
                {{- site.first_name_zh -}}
              {% endif %}
            {% else %}
              {% comment %} English name {% endcomment %}
              {% if site.first_name %}
                <span class="font-weight-bold">
                  {{- site.first_name -}}
                </span>
              {% endif %}
              {% if site.middle_name %}
                {{- site.middle_name -}}
              {% endif %}
              {% if site.last_name %}
                {{- site.last_name -}}
              {% endif %}
            {% endif %}
          {% else %}
            {{- site.title -}}
          {% endif %}
        </a>
      {% elsif site.enable_navbar_social %}
        <!-- Social Icons -->
        <div class="navbar-brand social">{% include social.liquid %}</div>
      {% endif %}
      <!-- Navbar Toggle -->
      <button
        class="navbar-toggler collapsed ml-auto"
        type="button"
        data-toggle="collapse"
        data-target="#navbarNav"
        aria-controls="navbarNav"
        aria-expanded="false"
        aria-label="Toggle navigation"
      >
        <span class="sr-only">Toggle navigation</span>
        <span class="icon-bar top-bar"></span>
        <span class="icon-bar middle-bar"></span>
        <span class="icon-bar bottom-bar"></span>
      </button>

      <div class="collapse navbar-collapse text-right" id="navbarNav">
        <ul class="navbar-nav ml-auto flex-nowrap">
          {% comment %} Get About page title based on current language {% endcomment %}
          {% if page.language == 'zh' or page.permalink == '/zh/' %}
            {% for p in site.pages %}
              {% if p.permalink == '/zh/' %} {% assign about_title = p.title %} {% assign about_url = '/zh/' %} {% endif %}
            {% endfor %}
          {% else %}
            {% for p in site.pages %}
              {% if p.permalink == '/' %} {% assign about_title = p.title %} {% assign about_url = '/' %} {% endif %}
            {% endfor %}
          {% endif %}

          <!-- About -->
          <li class="nav-item {% if page.permalink == '/' or page.permalink == '/zh/' %}active{% endif %}">
            <a class="nav-link" href="{{ about_url | relative_url }}">
              {{- about_title }}
              {% if page.permalink == '/' or page.permalink == '/zh/' %}
                <span class="sr-only">(current)</span>
              {% endif %}
            </a>
          </li>

          <!-- Other pages -->
          {% assign sorted_pages = site.pages | sort: 'nav_order' %}
          {% assign is_current_chinese = false %}
          {% if page.language == 'zh' or page.permalink contains '/zh/' %}
            {% assign is_current_chinese = true %}
          {% endif %}
          {% assign processed_orders = '' %}
          {% for p in sorted_pages %}
            {% if p.nav and p.autogen == null %}
              {% comment %} Skip pages that don't match current language {% endcomment %}
              {% assign is_chinese_page = false %}
              {% if p.language == 'zh' %}
                {% assign is_chinese_page = true %}
              {% elsif p.permalink and p.permalink contains '/zh/' %}
                {% assign is_chinese_page = true %}
              {% endif %}
              
              {% comment %} Skip if language doesn't match, but allow pages without language field (like CV) {% endcomment %}
              {% assign has_language = false %}
              {% if p.language %}
                {% assign has_language = true %}
              {% elsif p.permalink and p.permalink contains '/zh/' %}
                {% assign has_language = true %}
              {% endif %}
              
              {% if has_language and is_chinese_page != is_current_chinese %}
                {% continue %}
              {% endif %}
              
              {% comment %} Skip if we've already processed this nav_order for the same language {% endcomment %}
              {% if p.nav_order %}
                {% assign order_str = p.nav_order | append: ',' | append: is_chinese_page | append: ',' %}
                {% if processed_orders contains order_str %}
                  {% continue %}
                {% endif %}
                {% assign processed_orders = processed_orders | append: order_str %}
              {% endif %}
              
              {% assign nav_page = p %}
              
              {% if nav_page.dropdown %}
                {% assign has_active_child = false %}
                {% for child in nav_page.children %}
                  {% if page.title == child.title %}
                    {% assign has_active_child = true %}
                  {% endif %}
                {% endfor %}
                <li class="nav-item dropdown {% if page.title == nav_page.title or has_active_child %}active{% endif %}">
                  <a
                    class="nav-link dropdown-toggle"
                    href="#"
                    id="navbarDropdown"
                    role="button"
                    data-toggle="dropdown"
                    aria-haspopup="true"
                    aria-expanded="false"
                  >
                    {{- nav_page.title }}
                    {% if page.title == nav_page.title or has_active_child %}
                      <span class="sr-only">(current)</span>
                    {% endif %}
                  </a>
                  <div class="dropdown-menu dropdown-menu-right" aria-labelledby="navbarDropdown">
                    {% for child in nav_page.children %}
                      {% if child.title == 'divider' %}
                        <div class="dropdown-divider"></div>
                      {% else %}
                        <a
                          class="dropdown-item {% if page.title == child.title %}active{% endif %}"
                          href="{% if child.permalink contains '://' %}{{ child.permalink }}{% else %}{{ child.permalink | relative_url }}{% endif %}"
                        >
                          {{- child.title -}}
                        </a>
                      {% endif %}
                    {% endfor %}
                  </div>
                </li>
              {% else %}
                {% assign parent_link = nav_page.permalink | remove: 'index.html' %}
                <li class="nav-item {% if page.url contains parent_link or page.permalink == nav_page.permalink %}active{% endif %}">
                  {%- if nav_page.permalink contains '://' -%}
                    {%- assign url = nav_page.permalink -%}
                  {%- elsif nav_page.permalink contains '/blog/' -%}
                    {%- assign url = '/blog/' -%}
                  {%- else -%}
                    {%- assign url = nav_page.permalink -%}
                  {%- endif %}
                  <a class="nav-link" href="{{ url | relative_url }}">
                    {{- nav_page.title }}
                    {% if page.permalink == nav_page.permalink %}
                      <span class="sr-only">(current)</span>
                    {% endif %}
                  </a>
                </li>
              {% endif %}
            {% endif %}
          {% endfor %}
          {% if site.search_enabled %}
            <!-- Search -->
            <li class="nav-item">
              <button id="search-toggle" title="Search" onclick="openSearchModal()">
                <span class="nav-link">ctrl k <i class="ti ti-search"></i></span>
              </button>
            </li>
          {% endif %}
          <!-- Language Switcher -->
          <li class="nav-item">
            {% if page.language == 'zh' or page.permalink == '/zh/' %}
              <a class="nav-link" href="{{ '/' | relative_url }}" title="English">
                <span>EN</span>
              </a>
            {% else %}
              <a class="nav-link" href="{{ '/zh/' | relative_url }}" title="中文">
                <span>中文</span>
              </a>
            {% endif %}
          </li>
          {% if site.enable_darkmode %}
            <!-- Toogle theme mode -->
            <li class="toggle-container">
              <button id="light-toggle" title="Change theme">
                <i class="ti ti-sun-moon" id="light-toggle-system"></i>
                <i class="ti ti-moon-filled" id="light-toggle-dark"></i>
                <i class="ti ti-sun-filled" id="light-toggle-light"></i>
              </button>
            </li>
          {% endif %}
        </ul>
      </div>
    </div>
  </nav>
  {% if site.enable_progressbar %}
    <!-- Scrolling Progress Bar -->
    <progress id="progress" value="0">
      <div class="progress-container">
        <span class="progress-bar"></span>
      </div>
    </progress>
  {% endif %}
</header>
