<div class="col">
  <div class="card h-100 hoverable">
    {% if project.img %}
      {% if project.redirect %}
        <a href="{{ project.redirect }}">
      {% elsif project.video and site.enable_video_embedding %}
        <!-- No link if video is available -->
      {% else %}
        <a href="{{ project.url | relative_url }}">
      {% endif %}
        {%
          include figure.liquid
          loading="eager"
          path=project.img
          sizes = "250px"
          alt="project thumbnail"
          class="card-img-top"
        %}
      {% if project.redirect or not project.video or not site.enable_video_embedding %}
        </a>
      {% endif %}
    {% endif %}
    <div class="card-body">
      <h2 class="card-title">
        {% if project.redirect %}
          <a href="{{ project.redirect }}" style="color: inherit; text-decoration: none;">{{ project.title }}</a>
        {% elsif project.video and site.enable_video_embedding %}
          {{ project.title }}
        {% else %}
          <a href="{{ project.url | relative_url }}" style="color: inherit; text-decoration: none;">{{ project.title }}</a>
        {% endif %}
      </h2>
      <p class="card-text">{{ project.description }}</p>
      <div class="row ml-1 mr-1 p-0">
        {% if project.github %}
          <div class="github-icon">
            <div class="icon" data-toggle="tooltip" title="Code Repository">
              <a href="{{ project.github }}"><i class="fa-brands fa-github gh-icon"></i></a>
            </div>
            {% if project.github_stars %}
              <span class="stars" data-toggle="tooltip" title="GitHub Stars">
                <i class="fa-solid fa-star"></i>
                <span id="{{ project.github_stars }}-stars"></span>
              </span>
            {% endif %}
          </div>
        {% endif %}
        {% if project.video and site.enable_video_embedding %}
          <div class="ml-2">
            <a class="abstract btn btn-sm z-depth-0" role="button" style="margin-top: 0.5rem;">Video</a>
          </div>
        {% elsif project.video %}
          <div class="ml-2">
            <a href="{{ project.video }}" class="btn btn-sm z-depth-0" role="button" style="margin-top: 0.5rem;" target="_blank">Video</a>
          </div>
        {% endif %}
      </div>
    </div>
    {% if project.video and site.enable_video_embedding %}
      <!-- Hidden video block -->
      <div class="abstract hidden" style="padding: 1rem; text-align: center;">
        {% include video.liquid path=project.video class="img-fluid rounded z-depth-1" controls=true preload="none" poster=project.img %}
      </div>
    {% endif %}
  </div>
</div>
